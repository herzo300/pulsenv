                              routeNum == '3' ? 'Интервал: 15 мин. Будни: 06:00 - 22:00. Выходные: 06:20 - 21:40.' :
                              routeNum == '4' ? 'Интервал: 10-12 мин. Ежедневно: 06:05 - 22:25.' :
                              routeNum == '5' ? 'Интервал: 20-25 мин. Ежедневно: 06:20 - 21:50.' :
                              routeNum == '9' ? 'Интервал: 15 мин. Ежедневно: 06:00 - 22:00.' :
                              routeNum == '10' ? 'Интервал: 15-18 мин. Будни: 06:15 - 22:05. Выходные: 06:30 - 21:30.' :
                              routeNum == '11' ? 'Интервал: 15 мин. Ежедневно: 06:00 - 22:00.' :
                              routeNum == '12' ? 'Интервал: 20-22 мин. Ежедневно: 06:30 - 21:40.' :
