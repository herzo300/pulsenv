        const LatLng(60.9550, 76.5720), // Вокзал
      ],
      '4': [
        const LatLng(60.9420, 76.6200),
        const LatLng(60.9400, 76.6200),
        const LatLng(60.9400, 76.5800), // Мира
        const LatLng(60.9330, 76.5800), // Чапаева
        const LatLng(60.9330, 76.5500), // Ленина
      ],
      '5': [
