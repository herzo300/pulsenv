              fillColor: _uiPanelFillStrong,
              blurSigma: 30,
              borderColors: [
                _uiGlow.withAlpha(_isNightMode ? 150 : 70),
                _uiGlow.withAlpha(30),
                Colors.transparent,
              ],
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Row(
                    children: [
                      Icon(Icons.business_rounded, color: _colorAccent),
