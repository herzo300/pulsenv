+  void _buildCameraMarkersSmoothly(List<Map<String, dynamic>> cameraRows) {
+    _cameraBatchTimer?.cancel();
+    
+    // Clear current markers first so we can have a fresh staggered entry
+    setState(() {
+      _cameraMarkers = [];
+    });
+
+    final markers = <Marker>[];
+    for (final item in cameraRows) {
+      final lat = item['lat'];
+      final lng = item['lng'];
+      final name = item['n'] ?? 'Камера';
+      final url = item['s'];
+      final serverName = item['name'] ?? name;
+      final serverUrl = (item['stream_url'] ?? url ?? '').toString();
+      final isSecret = item['is_secret'] == true;
+
+      if (lat != null && lng != null) {
+        final doubleLat = lat is num ? lat.toDouble() : double.tryParse(lat.toString()) ?? 0.0;
+        final doubleLng = lng is num ? lng.toDouble() : double.tryParse(lng.toString()) ?? 0.0;
+        final point = LatLng(doubleLat, doubleLng);
+        markers.add(Marker(
+          point: point,
+          width: 52,
+          height: 52,
+          child: GestureDetector(
+            onTap: () {
+              _emitSelectionHaptic();
+              _showLiveCamDialog(serverName.toString(), serverUrl);
+            },
+            child: AnimatedMapMarker(
+              animation: _markerPulseController,
+              color: isSecret ? const Color(0xFFF59E0B) : _colorPrimary,
+              icon: isSecret
+                  ? Icons.lock_outline_rounded
+                  : Icons.videocam_rounded,
+              size: 52,
+              seed: ((point.latitude + point.longitude).abs() % 1),
+              isDayMode: !_isNightMode,
+              shell: MarkerShell.circle,
+            ),
+          ),
+        ));
+      }
+    }
+
+    if (markers.isEmpty) return;
+
+    // Add in batches of 15 markers every 30 milliseconds to prevent UI thread lockups
+    int currentIndex = 0;
+    const batchSize = 15;
+
+    _cameraBatchTimer = Timer.periodic(const Duration(milliseconds: 30), (timer) {
+      if (!mounted) {
+        timer.cancel();
+        return;
+      }
+      
+      final nextIndex = math.min(currentIndex + batchSize, markers.length);
+      final batch = markers.sublist(currentIndex, nextIndex);
+      
+      setState(() {
+        _cameraMarkers.addAll(batch);
+      });
+      
+      currentIndex = nextIndex;
+      if (currentIndex >= markers.length) {
+        timer.cancel();
+      }
+    });
+  }
