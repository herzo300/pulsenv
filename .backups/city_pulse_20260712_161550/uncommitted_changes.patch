+  String _getShortDistrictName(String fullName) {
+    final regExp = RegExp(r'\d+');
+    final match = regExp.firstMatch(fullName);
+    if (match != null) {
+      return match.group(0)!;
+    }
+    if (fullName.length > 2) {
+      return fullName.substring(0, 2);
+    }
+    return fullName;
+  }
