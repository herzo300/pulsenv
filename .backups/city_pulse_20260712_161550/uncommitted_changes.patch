-  @override
-  void paint(Canvas canvas, Size size) {
-    final verticalPaint = Paint()
-      ..color = const Color(0xFF00E5FF).withAlpha(10)
-      ..strokeWidth = 1;
-    final horizontalPaint = Paint()
-      ..color = const Color(0xFF00E5FF).withAlpha(8)
