# Optional HTTPS overlay — use after placing certs in ./certs/
# Merge manually or replace nginx.conf when TLS is ready.

server {
    listen 80;
    server_name _;
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name _;
    client_max_body_size 25M;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    include /etc/nginx/conf.d/snippets/soobshio-locations.conf;
}
