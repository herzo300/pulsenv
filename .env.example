# Предпочтительно хранить секреты вне репозитория:
#   SOOBSHIO_ENV_FILE=C:/secure/soobshio/runtime.env
# или:
#   %USERPROFILE%/.soobshio/runtime.env
#
# Локальный .env допустим только для разработки.

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite:///./soobshio.db
# Proksi dlya test_db_connection.py (opcionalno): pip install PySocks
# SOCKS_PROXY=socks5://127.0.0.1:1080
# HTTP_PROXY=http://127.0.0.1:8080

# Telegram API (my.telegram.org)
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_PHONE=+1234567890
TG_BOT_TOKEN=your_bot_token
TARGET_CHANNEL=@your_channel

# AI Провайдеры
# Z.AI API (primary для анализа текста и фото)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_TEXT_MODEL=glm-5-turbo
ZAI_REQUEST_TIMEOUT=90

# Активный текстовый AI-провайдер: zai | litellm | ollama | keyword
AI_TEXT_PROVIDER=litellm
LITELLM_TEXT_MODEL=qwen-mini
LITELLM_REQUEST_TIMEOUT=20
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_REQUEST_TIMEOUT=180

# Cloud API ключ для тестирования Gemma 4 (если не хватает RAM на сервере)
# Можно получить на https://openrouter.ai/ или https://console.groq.com/
GEMMA_CLOUD_API_KEY=your_openrouter_or_groq_key

# JWT Secret
JWT_SECRET=your_jwt_secret
ADMIN_API_TOKEN=change_me
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
ENABLE_OSINT=false
ENABLE_PERSON_SEARCH=false
ENABLE_IMAGE_ONLY_VISUAL_SEARCH=false

# Firebase (legacy fallback)
FIREBASE_PROJECT_ID=your_project
FIREBASE_API_KEY=your_firebase_key
FIREBASE_RTDB_URL=https://your-firebase-rtdb.firebaseio.com

# Public API Timeweb backend
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Для edge function /send-email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# VK API
VK_SERVICE_TOKEN=your_vk_token

# MCP Fetch Server (для веб-парсинга Telegram и VK)
MCP_FETCH_SERVER_URL=http://localhost:3000
MCP_FETCH_ENABLED=false
MCP_FETCH_TIMEOUT=30.0

# Открытые данные Нижневартовска
NV_OPENDATA_API_KEY=your_opendata_key

# WAQI — Air Quality Index (бесплатный токен: https://aqicn.org/data-platform/token/)
WAQI_API_TOKEN=demo

# Sentiment Analysis (ruBERT модель, опционально)
SENTIMENT_MODEL=cointegrated/rubert-tiny-sentiment-balanced

# Tesseract OCR (путь к исполняемому файлу, Windows)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# YOLO модель (опционально, по умолчанию ищет yolo11n.onnx → yolov8n.onnx)
# YOLO_MODEL_PATH=models/yolo11n_city.onnx

# Gemma 4 Vision (мультимодальный анализ камер через Ollama)
# GEMMA4_VISION_MODEL=gemma4:4b
# GEMMA4_VISION_ENABLED=true

# Webhook (альтернатива polling — нет конфликта getUpdates)
# WEBHOOK_BASE_URL=https://your-domain.com  # HTTPS, для py scripts/maintenance/run_bot_webhook.py

# Администраторы Telegram бота (через запятую)
# Узнать свой ID: написать @userinfobot в Telegram
ADMIN_TELEGRAM_IDS=123456789,987654321
# Admin 2FA for mobile dashboard
ADMIN_2FA_PASSWORD=change_me
# Optional TOTP secret for authenticator apps (base32 preferred)
# ADMIN_2FA_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Прокси (если прямое соединение недоступно — geo-блокировки)
# PROXY_URL=http://127.0.0.1:1080
# или SOCKS5: PROXY_HOST=host PROXY_PORT=1080 PROXY_USER=user PROXY_PASS=pass
# USE_PROXY_FOR_EXTERNAL=true — использовать прокси для Firebase, VK

# Z.AI Vision (для анализа фото и Camera Watchdog)
# ZAI_VISION_MODEL=glm-4v-plus

# Camera Watchdog (автоанализ городских камер)
# WATCHDOG_ENABLED=false
# WATCHDOG_INTERVAL_SEC=600
# WATCHDOG_MAX_CONCURRENCY=4
# VISUAL_SEARCH_MAX_CONCURRENCY=4
