# Prefer storing secrets outside the repository:
#   SOOBSHIO_ENV_FILE=C:/secure/soobshio/runtime.env
# or:
#   %USERPROFILE%/.soobshio/runtime.env
#
# Local .env is for development only. Never commit real secrets.

# Database (SQLite for local dev; PostgreSQL in production)
DATABASE_URL=sqlite:///./soobshio.db
# Set false in production after `alembic upgrade head`
DB_AUTO_CREATE=true

# Telegram API (https://my.telegram.org)
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
TG_PHONE=+70000000000
TG_BOT_TOKEN=your_telegram_bot_token
TARGET_CHANNEL=-1000000000000

# JWT / admin (generate: openssl rand -base64 32)
JWT_SECRET=change-me-generate-with-openssl
ADMIN_API_TOKEN=change-me-generate-with-openssl
ADMIN_2FA_PASSWORD=change-me
# ADMIN_2FA_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_TELEGRAM_IDS=123456789,987654321

# Public API (no trailing slash; use https://your-domain.com in production)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
PRODUCTION=false

# Flutter build-time overrides (dart-define):
#   --dart-define=PUBLIC_API_BASE_URL=https://your-domain.com
#   --dart-define=BACKEND_PUBLIC_FALLBACK=https://your-domain.com

# AI providers
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZAI_TEXT_MODEL=glm-5-turbo
ZAI_REQUEST_TIMEOUT=90
AI_TEXT_PROVIDER=litellm
LITELLM_TEXT_MODEL=qwen-mini
LITELLM_REQUEST_TIMEOUT=20
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_REQUEST_TIMEOUT=180
GEMMA_CLOUD_API_KEY=your_openrouter_or_groq_key
OPENAI_API_KEY=your_openrouter_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Feature flags (OSINT endpoints require ADMIN_API_TOKEN when enabled)
ENABLE_OSINT=false
ENABLE_PERSON_SEARCH=false
ENABLE_IMAGE_ONLY_VISUAL_SEARCH=false

# Firebase (legacy fallback)
FIREBASE_PROJECT_ID=your_project
FIREBASE_API_KEY=your_firebase_key
FIREBASE_RTDB_URL=https://your-firebase-rtdb.firebaseio.com

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# VK API
VK_SERVICE_TOKEN=your_vk_token

# MCP Fetch Server
MCP_FETCH_SERVER_URL=http://localhost:3000
MCP_FETCH_ENABLED=false
MCP_FETCH_TIMEOUT=30.0

# Open data / air quality
NV_OPENDATA_API_KEY=your_opendata_key
WAQI_API_TOKEN=demo

# Sentiment / OCR
SENTIMENT_MODEL=cointegrated/rubert-tiny-sentiment-balanced
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Camera / Viseron
VISERON_ENABLED=true
VISERON_WEBHOOK_TOKEN=change-me
VLM_ENABLED=true
VLM_ON_DEMAND_ONLY=true
CAMERA_PROBE_INTERVAL_SEC=300
CAMERA_PROBE_ALERT_WEBHOOK=

# Production AI stack (docker compose profile ai)
ENABLE_AI_STACK=false

# Report retention cleanup on startup (default off — use a scheduled job instead)
REPORT_RETENTION_CLEANUP_ENABLED=false
REPORT_RETENTION_DAYS=30

# Timeweb VPS (deployment only — set on server, not in repo)
# TIMEWEB_IP=your.server.ip
# TIMEWEB_TOKEN=your_timeweb_api_token

# Optional proxy for external APIs
# PROXY_URL=http://127.0.0.1:1080
# USE_PROXY_FOR_EXTERNAL=true

# Webhook mode for Telegram bot (alternative to polling)
# WEBHOOK_BASE_URL=https://your-domain.com

# YooKassa payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Geo cache
REVERSE_GEO_CACHE_PATH=data/reverse_geocode_cache.json
REVERSE_GEO_REDIS_TTL=1209600

# Rate limiting (optional Redis backend)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
