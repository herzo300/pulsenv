# Timeweb production environment
#
# 1. Copy to .env on the server (never commit .env):
#      cp .env.production.template /opt/soobshio/.env
# 2. Generate secrets ON the server:
#      bash scripts/deployment/rotate_secrets.sh /opt/soobshio
#    Or locally: python scripts/deployment/generate_rotated_secrets.py
#    then scp secrets-rotation-2026.env to the VPS and pass as 2nd arg.
# 3. Rotate external API keys manually — see docs/SECRETS_ROTATION.md
# 4. TLS: Let's Encrypt cert for 45-153-68-59.sslip.io (or set SOOBSHIO_PUBLIC_DOMAIN)

POSTGRES_DB=soobshio
POSTGRES_USER=soobshio
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://soobshio:change_me@postgres:5432/soobshio

PUBLIC_API_BASE_URL=https://your-domain.com
PRODUCTION=true
BACKEND_CORS_ORIGINS=https://your-domain.com
PORT=8000
JWT_SECRET=change_me
ADMIN_API_TOKEN=change_me
ADMIN_2FA_PASSWORD=change_me
ADMIN_TELEGRAM_IDS=123456789

TG_API_ID=your_api_id
TG_API_HASH=your_api_hash
TG_PHONE=+70000000000
TG_BOT_TOKEN=your_bot_token
TARGET_CHANNEL=@monitornv
# Telegram MTProxy for monitoring on blocked networks (host:port:hexsecret)
TELEGRAM_MTPROXY=

NV_OPENDATA_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_TEXT_MODEL=glm-4.7-flash
AI_TEXT_PROVIDER=zai

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_VISION_MODEL=grok-2-vision-latest

VK_SERVICE_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_RTDB_URL=

ENABLE_OSINT=false
ENABLE_PERSON_SEARCH=false
ENABLE_IMAGE_ONLY_VISUAL_SEARCH=false
VISERON_ENABLED=true
VISERON_WEBHOOK_TOKEN=change_me
ENABLE_AI_STACK=false
